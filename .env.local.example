# 热点抓取 Agent - 环境变量配置

# === LLM 配置 ===
# 使用 DeepSeek（推荐，便宜且支持 function calling）
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 或者使用 OpenAI
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# === RSSHub 配置（抖音、小红书数据源）===
# 本地部署 RSSHub 后填写地址，默认 http://localhost:1200
RSSHUB_BASE_URL=http://localhost:1200

# === 内部调用令牌（必填，否则定时任务 tick 一律 401）===
# instrumentation 的每分钟定时器会带此令牌请求 /api/schedule/tick，middleware 只放行持牌请求。
# 用 `openssl rand -hex 32` 或任意 64 位随机串生成；本地与服务器填同一个即可。
INTERNAL_TOKEN=
